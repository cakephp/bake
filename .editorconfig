# This file is for unifying the coding style for different editors and IDEs
# editorconfig.org

root = true

[*]
end_of_line = lf
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.neon]
indent_style = tab

[*.neon.dist]
indent_style = tab

[*.yml]
indent_size = 2

[phars.xml]
indent_size = 2

[*.twig]
insert_final_newline = false

[tests/comparisons/Template/*.php]
insert_final_newline = false
